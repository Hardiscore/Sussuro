{
  "name": "sussurro-rpg",
  "private": true,
  "version": "1.2.5",
  "description": "Sussurro - Aplicativo de chamadas de voz e vídeo em grupo",
  "author": "Hardiscore",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hardiscore/Sussuro.git"
  },
  "homepage": "https://github.com/Hardiscore/Sussuro#readme",
  "main": "server.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node server.ts",
    "preview": "vite preview",
    "electron": "electron main.cjs",
    "electron:dev": "electron main.cjs",
    "clean": "rm -rf dist server.js release",
    "lint": "tsc --noEmit",
    "build:electron": "electron-builder --win",
    "build:store": "electron-builder --win appx --x64 -p never",
    "dist": "electron-builder --win --x64",
    "dist:publish": "electron-builder --win --x64 -p always"
  },
  "build": {
    "appId": "com.sussurro.rpg",
    "productName": "Sussurro RPG",
    "extraMetadata": {
      "main": "main.cjs"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Hardiscore",
        "repo": "Sussuro"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**/*",
      "**/node_modules/loopback-capture/**/*",
      "noise-suppressor.js",
      "video-effects.js"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "main.js",
      "preload.cjs",
      "preload.js",
      "index.html",
      "styles.css",
      "app.js",
      "webrtc.js",
      "chat.js",
      "lobby-chat.js",
      "observer-chat.js",
      "noise-suppressor.js",
      "video-effects.js",
      "firebase-config.js",
      "icon.ico",
      "package.json",
      "public/**/*",
      "node_modules/uiohook-napi/**/*",
      "!node_modules/uiohook-napi/prebuilds/darwin-*/**",
      "!node_modules/uiohook-napi/prebuilds/linux-*/**",
      "!node_modules/uiohook-napi/prebuilds/win32-arm64/**",
      "!node_modules/uiohook-napi/libuiohook/**",
      "!node_modules/uiohook-napi/src/**",
      "node_modules/loopback-capture/**/*",
      "!node_modules/loopback-capture/prebuilds/linux-*/**",
      "!node_modules/loopback-capture/src/**",
      "node_modules/@shiguredo/**/*",
      "!public/assets/aistudio/**"
    ],
    "win": {
      "icon": "icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Sussurro-RPG-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sussurro RPG",
      "runAfterFinish": true
    },
    "appx": {
      "applicationId": "SussurroRPG",
      "identityName": "Hardiscore.Sussurro",
      "publisher": "CN=A3982E2B-88CF-4BE3-B541-5CB798E9583B",
      "publisherDisplayName": "Hardiscore",
      "displayName": "Sussurro",
      "backgroundColor": "#1e1f22",
      "showNameOnTiles": true,
      "languages": ["pt-BR"],
      "capabilities": [
        "runFullTrust",
        "internetClient",
        "privateNetworkClientServer",
        "microphone",
        "webcam"
      ]
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "loopback-capture": "^3.0.2",
    "@shiguredo/noise-suppression": "^2025.1.0",
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "uiohook-napi": "^1.5.5",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "@google/genai@2.23.0": true,
    "electron@33.4.11": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "uiohook-napi@1.5.5": true
  }
}
