{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/*.map"],
    "redirects": [
      {
        "source": "/api/download/windows",
        "destination": "https://github.com/Hardiscore/Sussuro/releases/latest/download/Sussurro-RPG-Setup.exe",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/@(index.html|sw.js|registerSW.js|manifest.webmanifest)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
